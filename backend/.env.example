# ==============================================================================
# TREASURE CASINO - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values appropriate for your environment.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development # 'development' | 'production' | 'test'

# ------------------------------------------------------------------------------
# DATABASE SETTINGS (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (XAMPP default MariaDB):
# DATABASE_URL="mysql://root:@localhost:3306/treasure_db?connect_timeout=30"
#
# REMOTE / PRODUCTION SECURED DEPLOYMENT:
# DATABASE_URL="mysql://<db_user>:<db_password>@<db_host>:<db_port>/treasure_db?sslaccept=strict&connect_timeout=30"
#
# Individual components (optional, if using direct connection pool):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=treasure_db
DATABASE_URL="mysql://root:@localhost:3306/treasure_db?connect_timeout=30"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate cryptographically strong random strings in production (e.g., openssl rand -hex 32)
JWT_SECRET=your-256-bit-secret-here-change-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-here-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# CORS & NETWORKING
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins for the web admin dashboard and client apps
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes window
RATE_LIMIT_MAX=300         # Maximum requests per IP window

# ------------------------------------------------------------------------------
# DEFAULT ADMINISTRATOR (Used for initial database seeding only)
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_EMAIL=admin@treasure.com
ADMIN_DEFAULT_PASSWORD=ChangeThisPasswordImmediately!

# ------------------------------------------------------------------------------
# FINANCIAL & PAYMENT CONTROLS
# ------------------------------------------------------------------------------
# MANDATORY REQUIREMENT: Keep set to 'true' to keep deposits/withdrawals simulated.
# Real-money functionality must remain disabled until regulatory & provider approvals are confirmed.
SIMULATED_PAYMENTS_ONLY=true
PAYMENT_SIMULATION_DELAY_MS=1000
